{
  "name": "automation-exercise-cypress",
  "version": "1.0.0",
  "description": "E2E UI and API test automation for automationexercise.com using Cypress",
  "scripts": {
    "cy:open": "cypress open",
    "test": "cypress run",
    "test:ui": "cypress run --spec \"cypress/e2e/ui/**/*.cy.js\"",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.js\"",
    "test:hybrid": "cypress run --spec \"cypress/e2e/hybrid/**/*.cy.js\""
  },
  "keywords": ["cypress", "qa", "test-automation", "e2e", "api-testing"],
  "license": "MIT",
  "devDependencies": {
    "cypress": "^13.17.0",
    "cypress-mochawesome-reporter": "^3.8.2"
  }
}
